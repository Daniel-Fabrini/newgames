{
  "name": "playverse",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "PlayVerse — plataforma de minijogos (PWA) com 10 jogos, recordes locais e suporte a pt/en/es.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "~8.5.2",
    "@capacitor/core": "~8.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
